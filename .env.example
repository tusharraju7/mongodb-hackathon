# Copy this file to .env and fill in the values. .env is gitignored; never commit it.
# Values are shared privately by the repo owner. See docs/SETUP.md.

# --- MongoDB Atlas (hackathon sandbox, shared by the whole team) ---
MONGODB_URI=mongodb+srv://greenlight_app:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=greenlight

# --- LLM (via LangChain init_chat_model) ---
# Main model: compliance verdict only. Fast model: router, claim extraction, image reading, Q&A, drafting.
# The fast model must accept image input.
LLM_MODEL=anthropic:claude-opus-5-5
LLM_FAST_MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
# How hard the main model deliberates on a verdict: low | medium | high.
# "low" gives the same findings on the test ads in about 10 seconds; "medium" takes about 35.
LLM_EFFORT=low

# --- Voyage AI embeddings ---
VOYAGE_API_KEY=
# Do not change: the vector indexes are 1024-dimensional
VOYAGE_MODEL=voyage-3.5

# --- ElevenLabs (speech-to-text for audio ads, text-to-speech for regenerated and seeded audio) ---
ELEVENLABS_API_KEY=
# A stock voice id. No cloned or real-person voices.
ELEVENLABS_VOICE_ID=

# --- App ---
# Same value for the whole team so tokens work across laptops. Generate once: openssl rand -hex 32
JWT_SECRET=
# Password given to all seeded demo users
SEED_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Optional tracing (LangSmith). Every model call is tagged with its run id. ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Where traces go: set LANGSMITH_PROJECT, or the LANGSMITH_AGENT_ID / LANGSMITH_AGENT_ENVIRONMENT pair.
# Never both: LangSmith refuses to trace when both are present.
# LANGSMITH_PROJECT=greenlight

# --- Voyage rate limit ---
# Without a payment method a Voyage account allows 3 requests a minute. The backend makes one
# embedding request per review and waits and retries when limited.
# EMBED_RETRIES=3
# EMBED_RETRY_WAIT=21
